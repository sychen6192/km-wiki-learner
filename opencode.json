{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "librarian",
  "share": "disabled",
  "instructions": ["vault/_meta/Style Guide.md"],
  "permission": {
    "edit": {
      "*": "deny",
      "vault/*": "allow",
      "vault/**": "allow",
      "loop/state/*": "allow",
      "loop/state/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "python3 tools/vault.py*": "allow",
      "python3 -m unittest*": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "date*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "sudo *": "deny"
    }
  }
}
